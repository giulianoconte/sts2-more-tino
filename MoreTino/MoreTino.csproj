<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>

        <GodotPath>C:/megadot/MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>

        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <Sts2DataDir>$(MSBuildProjectDirectory)/libs</Sts2DataDir>
        <ModsPath>$(MSBuildProjectDirectory)/dist/</ModsPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>

        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);MSB3270;STS002</NoWarn>
        <BaseLibVersion>3.1.2</BaseLibVersion>
    </PropertyGroup>

    <!-- DeployToMods gates the post-build copy + Godot .pck export targets.
         Default false so a plain `dotnet build` is verify-only and does not
         touch ModsPath (which on a configured machine points at the live
         game install). The deploy.sh / redeploy.sh scripts pass
         /p:DeployToMods=true to opt in. -->
    <PropertyGroup>
        <DeployToMods Condition="'$(DeployToMods)' == ''">false</DeployToMods>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')" >
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
            <Publicize>False</Publicize>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="$(BaseLibVersion)" PrivateAssets="All" />
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="MoreTino/**" />
        <EmbeddedResource Remove="MoreTino/**" />
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore" />
        <None Include="MoreTino.json" />
        <None Include="project.godot"/>
        <None Include="MoreTino/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <Target Name="CheckDependencyPaths" >
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
        <Warning
                Text=" Godot not found at path '$(GodotPath)' - .pck export will be skipped (mod_image will not appear in the mod menu)."
                Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')" />
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent"
            Condition="'$(DeployToMods)' == 'true'">
        <Message Text="Copying .dll and manifest to mods folder." Importance="high" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <Copy SourceFiles="MoreTino.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/" />
        <!-- BaseLibVersion is a minimum floor for deployment, not a hard pin.
             If the deployed BaseLib.json reports a version >= floor, leave
             it alone (a newer install belongs to another mod or a manual
             update). Only deploy when nothing's there or it's older. -->
        <PropertyGroup>
            <_DeployedBaseLibJson>$(ModsPath)BaseLib/BaseLib.json</_DeployedBaseLibJson>
            <_DeployedBaseLibText Condition="Exists('$(_DeployedBaseLibJson)')">$([System.IO.File]::ReadAllText('$(_DeployedBaseLibJson)'))</_DeployedBaseLibText>
            <_DeployedBaseLibVersion Condition="'$(_DeployedBaseLibText)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_DeployedBaseLibText), '"version"\s*:\s*"v?([0-9]+(?:\.[0-9]+){1,3})"').Groups.get_Item(1).Value)</_DeployedBaseLibVersion>
        </PropertyGroup>
        <PropertyGroup Condition="'$(_DeployedBaseLibVersion)' != ''">
            <_BaseLibVersionCompare>$([System.Version]::Parse('$(_DeployedBaseLibVersion)').CompareTo($([System.Version]::Parse('$(BaseLibVersion)'))))</_BaseLibVersionCompare>
        </PropertyGroup>
        <PropertyGroup>
            <_BaseLibSatisfied>false</_BaseLibSatisfied>
            <_BaseLibSatisfied Condition="'$(_BaseLibVersionCompare)' != '' and $(_BaseLibVersionCompare) &gt;= 0">true</_BaseLibSatisfied>
        </PropertyGroup>

        <Message Condition="'$(_BaseLibSatisfied)' == 'true'"
                 Text="Skipping BaseLib copy: deployed v$(_DeployedBaseLibVersion) satisfies floor v$(BaseLibVersion)." Importance="high" />
        <Message Condition="'$(_BaseLibSatisfied)' != 'true'"
                 Text="Copying BaseLib v$(BaseLibVersion) to mods folder (deployed: '$(_DeployedBaseLibVersion)')." Importance="high" />
        <ItemGroup Condition="'$(_BaseLibSatisfied)' != 'true'">
            <BaseLibFiles Include="$(NuGetPackageRoot)/alchyr.sts2.baselib/$(BaseLibVersion)/lib/**/BaseLib.dll;$(NuGetPackageRoot)/alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.pck;$(NuGetPackageRoot)/alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.json;"/>
        </ItemGroup>
        <Copy Condition="'$(_BaseLibSatisfied)' != 'true'"
              SourceFiles="@(BaseLibFiles)" DestinationFolder="$(ModsPath)BaseLib/" />
    </Target>

    <!-- Godot .pck export — packages resources in MoreTino/ subdir (currently
         just mod_image.png) into MoreTino.pck alongside the DLL. Required for
         the mod thumbnail to appear in the in-game mod menu: BaseLib loads it
         from res://MoreTino/mod_image.png inside the pck.
         Needs Godot 4.5.1 (or MegaDot 4.5.1) on-disk — path set in local.props.
         Runs the Godot binary headless with the "BasicExport" preset from
         export_presets.cfg. Skipped (with a warning from CheckDependencyPaths)
         if GodotPath isn't configured. -->
    <ItemGroup>
        <GodotPckInput Include="project.godot;export_presets.cfg;MoreTino/**/*" />
    </ItemGroup>

    <Target Name="GodotPublish" AfterTargets="CopyToModsFolderOnBuild"
            Condition="'$(DeployToMods)' == 'true' and '$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'"
            Inputs="@(GodotPckInput)"
            Outputs="$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck">
        <Message Text="Exporting Godot .pck to mods folder" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue"/>
    </Target>

    <Target Name="GodotPublishSkipped" AfterTargets="CopyToModsFolderOnBuild"
            Condition="'$(DeployToMods)' == 'true' and ('$(GodotPath)' == '' or !Exists('$(GodotPath)'))">
        <Message Text="Skipping Godot .pck export because GodotPath is not configured." Importance="high"/>
    </Target>

    <Import Project="local.props" Condition="Exists('local.props')" />
</Project>
